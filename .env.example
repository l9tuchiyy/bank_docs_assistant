# Не коммитьте файл .env: он содержит секреты.
# Скопируйте этот файл в .env и заполните значения.

# Токен для доступа к админ-панели /admin.
ADMIN_TOKEN=change-this-to-a-long-random-value

# Qwen 2.5 через OpenRouter. Получите ключ на https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Опциональная локальная модель Ollama.
LLM_ENABLED=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
